PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backweb_db
DB_USER=postgres
DB_PASSWORD=

# Autenticación: configura una clave privada fuera del repositorio antes de arrancar.
# 32 bytes de CSPRNG en hexadecimal (64 caracteres). Nunca usar una frase o ejemplo.
AUTH_JWT_SECRET_HEX=
AUTH_JWT_ISSUER=bitlearn-api
AUTH_JWT_AUDIENCE=bitlearn-web
# Duraciones: Access Token 900 segundos; sesión/Refresh Token 7 días.
# Secure por defecto, incluso detrás del proxy HTTPS de Codespaces/Vite.
AUTH_ALLOW_INSECURE_COOKIE=false
# Solo HTTP local: NODE_ENV=development y AUTH_ALLOW_INSECURE_COOKIE=true.
# Prohibido en producción y Codespaces. Producción requiere HTTPS externo.
NODE_ENV=development
